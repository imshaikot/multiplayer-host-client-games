      "id": 72,
      "text": "৪২ ডিগ্রি গরমে CNG ড্রাইভারের বগল।"
    },
    {
      "id": 73,
      "text": "৪ ঘণ্টার বাসে গায়ে হেলে পড়া একটা অপরিচিত আঙ্কেল।"
    },
    {
      "id": 74,
      "text": "এক প্যাকেট পচা শুঁটকি।"
    },
    {
      "id": 75,
      "text": "একটা ঘামে ভেজা ৫০০ টাকার নোট।"
    },
    {
      "id": 76,
      "text": "ঈদ সালামির নোটে চাচার থুতু।"
    },
    {
      "id": 77,
      "text": "ঘামে চটচটে একটা পাঞ্জাবি।"
    },
    {
      "id": 78,
      "text": "ছিঁড়ে যাওয়া একটা পাজামার দড়ি।"
    },
    {
      "id": 79,
      "text": "ঈদের জামাতে হঠাৎ খুলে যাওয়া একটা লুঙ্গি।"
    },
    {
      "id": 80,
      "text": "১২ দিন ধরে একই মোজা।"
    },
    {
      "id": 81,
      "text": "শ্বশুরের মুখে পচা পান।"
    },
    {
      "id": 82,
      "text": "ঈদের নামাজের লাইনে চেপে রাখা একটা ঢেকুর।"
    },
    {
      "id": 83,
      "text": "বাবার পেটের গভীর গর্জন।"
    },
    {
      "id": 84,
      "text": "ভর্তা-ভাত খাওয়ার পরের একটা স্বর্গীয় বায়ু।"
    },
    {
      "id": 85,
      "text": "চার পদের ডাল — এক বসায়।"
    },
    {
      "id": 86,
      "text": "হাফ প্লেট কাচ্চি বিরিয়ানি।"
    },
    {
      "id": 87,
      "text": "লিফটে আগের জনের রেখে যাওয়া গন্ধ।"
    },
    {
      "id": 88,
      "text": "ছেলের প্রথম পাদ।"
    },
    {
      "id": 89,
      "text": "একটা সংরক্ষিত পাদ।"
    },
    {
      "id": 90,
      "text": "চাচার দাড়িতে আটকে থাকা সকালের পরোটার কণা।"
    },
    {
      "id": 91,
      "text": "নাক দিয়ে বেরিয়ে আসা একটা ঢেকুর।"
    },
    {
      "id": 92,
      "text": "একটা পান্তা-ভাতের সাথে দু-দিনের পুরনো শুঁটকি।"
    },
    {
      "id": 93,
      "text": "একটা বাসর রাতের সশব্দ ঢেকুর।"
    },
    {
      "id": 94,
      "text": "আঙ্কেলের তিনতলা-শোনা ঢেকুর।"
    },
    {
      "id": 95,
      "text": "ঈদ-পরবর্তী একটা পরিবার-গ্যাস্ট্রিক।"
    },
    {
      "id": 96,
      "text": "মামার জুতা খুলে ঘরে ঢোকার ১২ সেকেন্ড পরের পরিবেশ।"
    },
    {
      "id": 97,
      "text": "মেঝেতে পড়ে থাকা শ্বশুরের লুঙ্গির গিঁট।"
    },
    {
      "id": 98,
      "text": "টয়লেটে ঠিক আমার পরের জন বড় চাচা।"
    },
    {
      "id": 99,
      "text": "এক ঘণ্টা নাকে আঙুল দিয়ে বসে থাকা চার বছরের ভাইপো।"
    },
    {
      "id": 100,
      "text": "নজরুলের আবক্ষ মূর্তি।"
    },
    {
      "id": 101,
      "text": "শেখ মুজিবের একটা পুরনো পোস্টার।"
    },
    {
      "id": 102,
      "text": "হুমায়ূন আহমেদের হিমু।"
    },
    {
      "id": 103,
      "text": "কোক স্টুডিও বাংলা।"
    },
    {
      "id": 104,
      "text": "হাজীর বিরিয়ানি।"
    },
    {
      "id": 105,
      "text": "একটা পদ্মার ইলিশ।"
    },
    {
      "id": 106,
      "text": "বঙ্গবন্ধু টানেল।"
    },
    {
      "id": 107,
      "text": "মেট্রোরেল।"
    },
    {
      "id": 108,
      "text": "শাহবাগ আন্দোলন।"
    },
    {
      "id": 109,
      "text": "একটা ঈদের নাটক।"
    },
    {
      "id": 110,
      "text": "শাকিব খানের একটা সিনেমা।"
    },
    {
      "id": 111,
      "text": "একুশে বইমেলা।"
    },
    {
      "id": 112,
      "text": "একটা ১৬ ডিসেম্বরের কুচকাওয়াজ।"
    },
    {
      "id": 113,
      "text": "ছায়ানটের পহেলা বৈশাখ।"
    },
    {
      "id": 114,
      "text": "একটা বিপিএল ম্যাচ।"
    },
    {
      "id": 115,
      "text": "TSC-র সাত টাকার চা।"
    },
    {
      "id": 116,
      "text": "শহীদ মিনার।"
    },
    {
      "id": 117,
      "text": "মেট্রোরেলের নারী কামরা।"
    },
    {
      "id": 118,
      "text": "কাচ্চির আলু আন্দোলন।"
    },
    {
      "id": 119,
      "text": "চাচার ৫০তম মুক্তিযুদ্ধ-গল্প।"
    },
    {
      "id": 120,
      "text": "একটা একুশের কালো ব্যাজ।"
    }
  ]
}