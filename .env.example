# Get a free API key at https://developers.giphy.com/dashboard/
# When unset, the UI falls back to animated emoji reactions.
GIPHY_API_KEY=DZuaMHqNf5LsBJ17I8K0R8mR6uyGM4Wb

# Sub-path the app is served under in production (e.g. /ay-nachi).
# Leave empty when serving from the domain root.
# Used by next.config.mjs (basePath/assetPrefix) and the Socket.IO path.
NEXT_PUBLIC_BASE_PATH=

# Full public URL, used by the host view to build the join QR code.
# Include the base path if present (e.g. https://example.com/ay-nachi).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PIN gate for HOST entry (the /ay-nachi hub + /host/* screens). Verified
# server-side by /api/host-pin — this value is NOT exposed to the browser (no
# NEXT_PUBLIC_ prefix). Players joining via the share link (?code=…) are never
# prompted. The client only remembers the "unlocked" flag per browser session
# (closing the tab re-locks). Defaults to BORA when unset.
HOST_PIN=BORA

# Node runtime mode. npm scripts set this; override only if you know why.
NODE_ENV=development

# Port for the custom server (server.js).
PORT=3000
